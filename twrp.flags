/system_root    ext4    /dev/block/mapper/system        flags=display="System";backup=0;logical
/system_ext     ext4    /dev/block/mapper/system_ext    flags=display="System EXT";backup=0;logical
/product        ext4    /dev/block/mapper/product       flags=display="Product";backup=0;logical
/vendor         ext4    /dev/block/mapper/vendor        flags=display="Vendor";backup=0;logical

/usb_otg        auto    /dev/block/sdg1      /dev/block/sdg     flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"
