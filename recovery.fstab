# mount_point  fstype  device                                   fs_mgr_flags

/boot          emmc    /dev/block/bootdevice/by-name/boot       defaults
/dtbo          emmc    /dev/block/bootdevice/by-name/dtbo       defaults
/cache         ext4    /dev/block/bootdevice/by-name/cache      defaults
/recovery      emmc    /dev/block/bootdevice/by-name/recovery   defaults
/system_root   ext4    /dev/block/bootdevice/by-name/system     defaults
/vendor        ext4    /dev/block/bootdevice/by-name/vendor     defaults
/data          f2fs    /dev/block/bootdevice/by-name/userdata   defaults
/cust          ext4    /dev/block/bootdevice/by-name/cust       defaults
/misc          emmc    /dev/block/bootdevice/by-name/misc       defaults
